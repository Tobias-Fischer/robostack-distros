diff --git a/ros2cli/completion/conda/_ros2 b/ros2cli/completion/conda/_ros2
new file mode 100644
index 000000000..70927f705
--- /dev/null
+++ b/ros2cli/completion/conda/_ros2
@@ -0,0 +1,8 @@
+#compdef ros2
+# zsh autoloads this from $fpath (site-functions) the first time ros2 is
+# completed: register argcomplete's completion function for ros2, which replaces
+# this one, and complete with it
+if (( $+commands[register-python-argcomplete] )); then
+  eval "$(register-python-argcomplete ros2)"
+  _python_argcomplete "$@"
+fi
diff --git a/ros2cli/completion/conda/ros2 b/ros2cli/completion/conda/ros2
new file mode 100644
index 000000000..0ee81b139
--- /dev/null
+++ b/ros2cli/completion/conda/ros2
@@ -0,0 +1,5 @@
+# bash completion for ros2, under the name bash-completion loads on demand
+# (completions/<command>); pixi shell sources this directory when activating
+if type register-python-argcomplete > /dev/null 2>&1; then
+  eval "$(register-python-argcomplete ros2)"
+fi
diff --git a/ros2cli/completion/conda/ros2.fish b/ros2cli/completion/conda/ros2.fish
new file mode 100644
index 000000000..3953b7cbc
--- /dev/null
+++ b/ros2cli/completion/conda/ros2.fish
@@ -0,0 +1,5 @@
+# fish completion for ros2, under the name fish loads on demand
+# (vendor_completions.d/<command>.fish)
+if type -q register-python-argcomplete
+    register-python-argcomplete --shell fish ros2 | source
+end
diff --git a/ros2cli/setup.py b/ros2cli/setup.py
index 458010cbb..d27ccfc6b 100644
--- a/ros2cli/setup.py
+++ b/ros2cli/setup.py
@@ -24,6 +24,13 @@ setup(
             'completion/ros2-argcomplete.fish',
             'completion/ros2-argcomplete.zsh',
         ]),
+
+        # [conda] completion scripts under the names the shells load on demand
+        # (bash-completion: completions/<command>, zsh: $fpath/_<command>, fish:
+        # vendor_completions.d/<command>.fish), which pixi shell activates
+        ('share/bash-completion/completions', ['completion/conda/ros2']),
+        ('share/zsh/site-functions', ['completion/conda/_ros2']),
+        ('share/fish/vendor_completions.d', ['completion/conda/ros2.fish']),
     ],
     package_data={'': ['py.typed']},
     zip_safe=False,
