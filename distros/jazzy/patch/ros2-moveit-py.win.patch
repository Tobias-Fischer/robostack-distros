diff --git a/src/moveit/moveit_py_utils/CMakeLists.txt b/src/moveit/moveit_py_utils/CMakeLists.txt
index 132da74..b730ac8 100644
--- a/src/moveit/moveit_py_utils/CMakeLists.txt
